# Agente Gomme Fenice (Matteo) - modelo do .env. Copie para .env e preencha.
# Tudo roda com a chave Gemini: conversa, transcricao do audio recebido e resposta em audio.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

HELENA_BASE_URL=https://api.helena.run
HELENA_WTS_BASE_URL=https://api.wts.chat

# PRODUCAO - conta Helena da Gomme Fenice (token e equipe do fluxo n8n "agente original").
HELENA_PROD_MESSAGE_TOKEN=
HELENA_PROD_TAG_TOKEN=
HELENA_PROD_FILE_TOKEN=
HELENA_PROD_PANEL_ID=
HELENA_PROD_STEP_ID_NOVO_LEAD=
HELENA_PROD_STEP_ID_EM_ATENDIMENTO=
# Equipe que recebe o atendimento (newDepartmentId do node transferirAtendimento).
HELENA_PROD_DEPARTMENT_ID=
# Equipe onde o bot trabalha - rode: docker compose exec api python scripts/list_helena_departments.py producao
HELENA_PROD_BOT_DEPARTMENT_ID=

# TESTE - sandbox compartilhado da agencia (ambiente de testes padrao). Preencher com os
# mesmos valores HELENA_TEST_* dos outros agentes, ou pelo painel (/dashboard/settings).
HELENA_TEST_MESSAGE_TOKEN=
HELENA_TEST_TAG_TOKEN=
HELENA_TEST_FILE_TOKEN=
HELENA_TEST_PANEL_ID=
HELENA_TEST_STEP_ID_NOVO_LEAD=
HELENA_TEST_STEP_ID_EM_ATENDIMENTO=
HELENA_TEST_DEPARTMENT_ID=
HELENA_TEST_BOT_DEPARTMENT_ID=

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://agente_gomme:changeme@postgres:5432/agente_gomme
REDIS_URL=redis://redis:6379/0
DEBOUNCE_SECONDS=5

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# OBSERVABILIDADE (app/observabilidade.py). Sem as DUAS chaves o Langfuse fica desligado e
# nada sai do processo - e' o padrao. O trace leva a fala do cliente: o servidor precisa ser
# self-hosted (LGPD/GDPR). LANGFUSE_PUBLIC_URL so e' preciso quando o endereco que o navegador
# abre e' diferente do que o container usa.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_URL=
# Tag de versao nos traces (ex.: gomme-fenice@2026-10-20).
APP_VERSION=dev
